# Development environment variables (TEMPLATE - contains placeholder values)
# Copy this file to .env.development.local and replace with real credentials
# .env.development.local is gitignored and will not be committed

# API base URL for local development
VITE_API_URL=http://localhost:3000

# Firebase Web App Configuration
# These defaults point the app at the local Firebase emulators
# (cd app && npm run emulators). The demo- project id guarantees nothing
# reaches a real project. To use the real project instead, put its values
# in .env.development.local and set VITE_FIREBASE_USE_EMULATORS= (empty).
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-local-catch
VITE_FIREBASE_STORAGE_BUCKET=demo-local-catch.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=demo
VITE_FIREBASE_APP_ID=demo
VITE_FIREBASE_USE_EMULATORS=true

# Backend (server-side only) - must match VITE_FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Database owner connection string
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
