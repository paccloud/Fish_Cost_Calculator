# Environment Variables Template
# Copy this file to .env.development.local (untracked) for local development.
# Never copy it over the tracked .env.development or .env.production; see SECURITY_NOTICE.md.

# API Configuration
# For local development, use: http://localhost:3000
# For production, leave empty (same-origin)
VITE_API_URL=http://localhost:3000

# Firebase Web App Configuration
# Get these from Firebase Console > Project Settings > Your apps > Web app
# Frontend (Vite) - these get bundled into the client
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

VITE_GEMINI_API_KEY=AIza...

# Backend settings do not belong in this file (Vite only exposes VITE_* values to the client).
#  - Local Express server: copy server/.env.example to server/.env
#    (FIREBASE_PROJECT_ID must match VITE_FIREBASE_PROJECT_ID exactly).
#  - Production (Vercel): set DATABASE_URL, FIREBASE_PROJECT_ID and ALLOWED_ORIGINS in project settings.
#  - Database scripts in scripts/: export DATABASE_URL in your shell; never put it in a tracked file.
